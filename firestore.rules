rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
//  TEAM OP — RÈGLES DU PROJET « elan-gestion » : OP GESTION et l'espace client
//
//  C'est ce qui tourne dans la console. Où coller : console.firebase.google.com →
//  projet elan-gestion → Firestore Database → onglet « Règles » → tout remplacer → Publier.
//
//  OP MESSAGES n'est plus ici — décision de Justin, 10 septembre 2026 : la messagerie
//  n'est pas en service, elle aura son propre projet Firebase (ses règles :
//  firestore-opmessages.rules). Tant que messages.html n'a pas été basculée dessus, la
//  messagerie est hors d'usage : tout ce qui n'est pas listé ici est fermé, et c'est voulu.
// ══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── LES OUTILS ──────────────────────────────────────────────────────
    function connecte()      { return request.auth != null; }
    function moi()           { return request.auth.uid; }
    function cestMoi(uid)    { return connecte() && moi() == uid; }

    // ══ ESPACE CLIENT ET SUPPORT ══════════════════════════════════════════
    match /teamop_requests/{uid} {
      allow read:   if cestMoi(uid);
      allow create: if cestMoi(uid);
      allow update: if cestMoi(uid);
      allow delete: if false;
    }
    match /teamop_threads/{uid} {
      allow read, write: if cestMoi(uid);
      match /msgs/{msgId} {
        allow read:   if cestMoi(uid);
        allow create: if cestMoi(uid);
        allow update: if cestMoi(uid);
        allow delete: if false;
      }
    }
    match /teamop_news/{newsId} {
      allow read:  if connecte();
      allow write: if false;
    }

    // ══ OP GESTION ════════════════════════════════════════════════════════
    // ── LA PORTE DE VERSION — 9 septembre 2026 ──
    // Ce qui a détruit les comptes d'ELAN : un appareil resté en vieille version, qui
    // réécrit TOUTE la base de l'entreprise avec sa copie périmée, toutes les deux
    // minutes. On ne peut pas mettre à jour un appareil qu'on ne tient pas ; on peut lui
    // refuser la porte. Chaque écriture de l'application porte son numéro de version
    // (`verNum`, un entier). En dessous du minimum fixé depuis la Tour de contrôle
    // (teamop_config/version → min), le serveur de Google refuse l'écriture : l'appareil
    // continue de LIRE, ne peut plus rien abîmer, et l'application se met à jour seule.
    // Une version d'avant ce verrou n'a pas de `verNum` : elle passe tant qu'aucun
    // minimum n'est exigé (min = 0 ou document absent), plus jamais ensuite.
    function versionMin() {
      return exists(/databases/$(database)/documents/teamop_config/version)
        ? get(/databases/$(database)/documents/teamop_config/version).data.get('min', 0)
        : 0;
    }
    function versionOk() {
      return versionMin() == 0
        || (request.resource.data.get('verNum', 0) is int
            && request.resource.data.get('verNum', 0) >= versionMin());
    }
    // ── ⛔ LA DETTE OUVERTE : « connecté » NE VEUT PAS DIRE « de cette entreprise » ──
    // connecte() n'exige qu'un compte ANONYME — celui que l'application se crée elle-même
    // (app.html, signInAnonymously). {teamId} n'est comparé à rien. Donc, aujourd'hui :
    //   • LECTURE : n'importe quel compte anonyme lit le document de n'importe quelle
    //     entreprise. Reproduit le 10 septembre 2026 — avec les seules constantes du fichier
    //     servi publiquement (SYNC_SECRET_DEFAULT, SYNC_SALT), le contenu d'une entreprise
    //     restée sur la clé par défaut se déchiffre INTÉGRALEMENT : nom, adresses et
    //     téléphones des clients, montants, mot de passe administrateur.
    //   • ÉCRITURE : elle ne demande AUCUNE clé. versionOk() ne sépare rien — `verNum` est
    //     fourni par celui qui écrit. Écraser le document d'une entreprise, y compris une
    //     entreprise à clé propre, ne demande donc rien d'autre qu'un compte anonyme.
    //
    // LE REMÈDE EST PRÊT CÔTÉ CODE (v640) mais PAS ENCORE PUBLIÉ ICI, et c'est délibéré.
    // Le serveur TeamOP délivre désormais, contre la preuve de la clé d'équipe, un jeton
    // signé qui porte l'entreprise (POST /api/fb/jeton → claims.t), et l'application s'en
    // sert au lieu de la connexion anonyme. Quand TOUS les appareils l'auront, remplacer le
    // bloc ci-dessous par :
    //
    //     match /elan_teams/{teamId} {
    //       allow read, write: if request.auth != null && request.auth.token.t == teamId;
    //     }
    //
    // ⚠️ DEUX CONDITIONS AVANT DE PUBLIER CETTE LIGNE, chacune payante si on l'oublie :
    //  1. Tous les appareils doivent présenter le jeton. Publier avant ferme la porte aux
    //     retardataires — qui perdent alors l'accès aux données de LEUR PROPRE entreprise.
    //     La Tour de contrôle sait exiger une version : c'est le même geste, dans le même
    //     ordre. D'abord tout le monde monte, ENSUITE la porte se ferme.
    //  2. L'espace de REPLI (voir ESPACES_INTOUCHABLES côté serveur) n'a pas de jeton : sa
    //     clé est écrite en clair dans app.html, une preuve venant de lui ne prouve rien.
    //     Les entreprises qui y vivent encore doivent d'abord déménager dans leur propre
    //     espace, avec leur propre clé — sans quoi cette règle les coupe toutes.
    match /elan_teams/{teamId} {
      allow read:   if connecte();
      allow write:  if connecte() && versionOk();
    }
    // Le minimum exigé : tout le monde le lit (l'application s'y compare avant même
    // d'écrire), personne ne l'écrit depuis l'application — il est posé par le serveur
    // TeamOP, avec sa clé d'administration, sur ordre de la Tour de contrôle.
    match /teamop_config/{doc} {
      allow read:  if connecte();
      allow write: if false;
    }

    // ── Le canal d'essai (beta.html / dev.html) ──
    // beta-build.js remplace le préfixe 'elan_ par 'elanB_ pour isoler les
    // données locales de la bêta ; la substitution touche aussi le nom de la
    // collection Firestore, qui devient 'elanB_teams'. Sans cette règle, la
    // bêta tombait sur le « tout le reste est fermé » et ne se synchronisait
    // pas. L'isolement est voulu : elle a ses propres données et ne touche
    // jamais à celles des entreprises. Même porte de version : la bêta porte
    // aussi son numéro.
    match /elanB_teams/{teamId} {
      allow read:   if connecte();
      allow write:  if connecte() && versionOk();
    }

    // ══ TOUT LE RESTE EST FERMÉ ═══════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
