rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
//  TEAM OP — LES RÈGLES DE SÉCURITÉ FIREBASE
//
//  À quoi ça sert : aujourd'hui, les verrous sont posés dans l'application.
//  Ils suffisent au quotidien, mais quelqu'un de très technique pourrait
//  les contourner en parlant directement à la base. Ces règles-ci sont
//  appliquées par le SERVEUR de Google : personne ne peut passer outre.
//
//  Où les coller : console.firebase.google.com → ton projet →
//  Firestore Database → onglet « Règles » → tout remplacer → Publier.
//
//  Le principe, en une phrase : chacun ne peut lire et écrire que ce qui
//  le concerne — son compte, son entreprise, ses réunions.
// ══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── LES OUTILS ──────────────────────────────────────────────────────
    function connecte()      { return request.auth != null; }
    function moi()           { return request.auth.uid; }
    function cestMoi(uid)    { return connecte() && moi() == uid; }

    // membre de l'entreprise : sa fiche existe dans members/
    function membre(cid) {
      return connecte()
        && exists(/databases/$(database)/documents/op_companies/$(cid)/members/$(moi()));
    }
    function maFiche(cid) {
      return get(/databases/$(database)/documents/op_companies/$(cid)/members/$(moi())).data;
    }
    // le patron : celui qui a créé l'entreprise, ou un membre « entreprise »
    function patron(cid) {
      return membre(cid) && (
        get(/databases/$(database)/documents/op_companies/$(cid)).data.ownerUid == moi()
        || maFiche(cid).role == 'entreprise'
      );
    }
    // le patron et les responsables ouvrent les réunions
    function responsable(cid) {
      return patron(cid) || (membre(cid) && maFiche(cid).role in ['responsable','entreprise']);
    }
    // on ne laisse pas quelqu'un se donner un rôle qu'il n'a pas
    function roleInchange(cid) {
      return !('role' in request.resource.data)
        || request.resource.data.role == resource.data.role
        || patron(cid);
    }

    // ══ LES COMPTES ═══════════════════════════════════════════════════════
    // Chacun écrit sa fiche. Les autres membres peuvent la LIRE : c'est ce
    // qui affiche le nom, la photo et « en ligne » dans les listes.
    match /op_users/{uid} {
      allow read:   if connecte();
      allow write:  if cestMoi(uid);

      // les appareils qui reçoivent les notifications : strictement privés
      match /devices/{deviceId} {
        allow read, write: if cestMoi(uid);
      }
      // le carnet de contacts : privé
      match /contacts/{contactId} {
        allow read, write: if cestMoi(uid);
      }
      // les invitations reçues : je les lis et je les efface ; un membre
      // de mon entreprise peut m'en déposer une
      match /invites/{inviteId} {
        allow read, delete: if cestMoi(uid);
        allow create:       if connecte();
        allow update:       if cestMoi(uid);
      }
    }

    // ══ LES ENTREPRISES ═══════════════════════════════════════════════════
    match /op_companies/{cid} {
      // on doit pouvoir lire la fiche pour rejoindre avec le code
      allow read:   if connecte();
      allow create: if connecte() && request.resource.data.ownerUid == moi();
      allow update: if patron(cid);
      allow delete: if patron(cid);

      // ── LES MEMBRES ──
      // On rejoint en s'inscrivant soi-même (avec le code de l'entreprise).
      // Le patron peut ajouter, modifier un rôle et retirer quelqu'un.
      match /members/{uid} {
        allow read:   if membre(cid);
        allow create: if cestMoi(uid) || patron(cid);
        allow update: if (cestMoi(uid) && roleInchange(cid)) || patron(cid);
        allow delete: if cestMoi(uid) || patron(cid);
      }

      // ── LES RÉUNIONS ────────────────────────────────────────────────────
      // LE VERROU QUE JUSTIN A DEMANDÉ : une réunion appartient à ceux qui
      // y sont invités. Les autres ne peuvent même pas la lire.
      match /rooms/{roomId} {
        function invite() {
          return resource.data.get('ouverte', false) == true
            || resource.data.createdBy == moi()
            || moi() in resource.data.get('members', [])
            || patron(cid);
        }
        allow read:   if membre(cid) && invite();
        allow create: if responsable(cid) && request.resource.data.createdBy == moi();
        // un invité peut signer son passage (participants, heures) ;
        // seul l'organisateur ou le patron peut renommer, replanifier,
        // changer la liste des invités
        allow update: if membre(cid) && invite();
        allow delete: if resource.data.createdBy == moi() || patron(cid);

        // les réponses à l'invitation (je viens / je ne viens pas)
        match /reponses/{uid} {
          allow read:  if membre(cid);
          allow write: if cestMoi(uid);
        }
      }

      // ── LES DISCUSSIONS ─────────────────────────────────────────────────
      match /channels/{chId} {
        function dansLeSalon() {
          return resource.data.get('type', '') == 'general'
            || moi() in resource.data.get('members', [])
            || patron(cid);
        }
        allow read:   if membre(cid) && dansLeSalon();
        allow create: if membre(cid) && moi() in request.resource.data.get('members', [moi()]);
        allow update: if membre(cid) && dansLeSalon();
        allow delete: if patron(cid) || resource.data.get('createdBy', '') == moi();

        // les messages : on lit ceux de ses discussions, on n'écrit qu'en
        // son propre nom, et on ne modifie/efface que ses propres messages
        match /messages/{msgId} {
          allow read:   if membre(cid);
          allow create: if membre(cid) && request.resource.data.get('from', moi()) == moi();
          allow update: if membre(cid);   // réactions, épingles, accusés
          allow delete: if membre(cid) && (resource.data.get('from', '') == moi() || patron(cid));

          // les votes d'un sondage : un vote par personne, le sien
          match /votes/{uid} {
            allow read:  if membre(cid);
            allow write: if cestMoi(uid);
          }
        }
        // « message lu » : chacun pose le sien
        match /reads/{uid} {
          allow read:  if membre(cid);
          allow write: if cestMoi(uid);
        }
      }

      // ── LES APPELS ET LA VISIO ──────────────────────────────────────────
      // Les fiches d'appel et les petits messages techniques qui font
      // fonctionner la visio (offres, réponses, présences). Réservés aux
      // membres de l'entreprise.
      match /calls/{callId} {
        allow read:   if membre(cid);
        allow create: if membre(cid);
        allow update: if membre(cid);
        allow delete: if membre(cid);
      }
    }

    // ══ LES ESPACES PERSONNELS (hors entreprise) ══════════════════════════
    match /op_channels/{chId} {
      function dedans() { return moi() in resource.data.get('members', []); }
      allow read:   if connecte() && dedans();
      allow create: if connecte() && moi() in request.resource.data.get('members', [moi()]);
      allow update: if connecte() && dedans();
      allow delete: if connecte() && dedans();

      match /messages/{msgId} {
        allow read:   if connecte();
        allow create: if connecte() && request.resource.data.get('from', moi()) == moi();
        allow update: if connecte();
        allow delete: if connecte() && resource.data.get('from', '') == moi();
        match /votes/{uid} { allow read: if connecte(); allow write: if cestMoi(uid); }
      }
      match /reads/{uid} { allow read: if connecte(); allow write: if cestMoi(uid); }
    }
    match /op_calls/{callId} {
      allow read, write: if connecte();
    }

    // ══ L'ESPACE CLIENT ET LE SUPPORT TEAM OP ═════════════════════════════
    // Chaque client ne voit que SON dossier et SA conversation.
    match /teamop_requests/{uid} {
      allow read:   if cestMoi(uid);
      allow create: if cestMoi(uid);
      allow update: if cestMoi(uid);
      allow delete: if false;                 // on ne supprime pas un dossier client
    }
    match /teamop_threads/{uid} {
      allow read, write: if cestMoi(uid);
      match /msgs/{msgId} {
        allow read:   if cestMoi(uid);
        allow create: if cestMoi(uid);
        allow update: if cestMoi(uid);
        allow delete: if false;               // l'historique du support se garde
      }
    }
    // les annonces TEAM OP : tout le monde les lit, personne ne les écrit
    // depuis l'application (elles sont posées depuis la console)
    match /teamop_news/{newsId} {
      allow read:  if connecte();
      allow write: if false;
    }

    // ══ OP GESTION — les données d'équipe ═════════════════════════════════
    match /elan_teams/{teamId} {
      allow read, write: if connecte();
    }

    // ── Le canal d'essai (beta.html / dev.html) ──
    // beta-build.js remplace le préfixe 'elan_ par 'elanB_ pour isoler les données locales
    // de la bêta. Cette substitution touche aussi le nom de la collection Firestore :
    // 'elan_teams' y devient 'elanB_teams'. Sans cette règle, la bêta tombait sur le
    // « tout le reste est fermé » et ne se synchronisait PAS — depuis toujours.
    // L'isolement est voulu : la bêta a ses propres données et ne touche jamais
    // à celles des entreprises.
    match /elanB_teams/{teamId} {
      allow read, write: if connecte();
    }

    // ══ TOUT LE RESTE EST FERMÉ ═══════════════════════════════════════════
    // Règle d'or : ce qui n'est pas explicitement autorisé plus haut est
    // interdit. Si une nouveauté de l'application cesse de fonctionner
    // après la publication de ces règles, c'est ici qu'il manque un bloc.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
