rules_version = '2';

// ══════════════════════════════════════════════════════════════════════════
//  TEAM OP — L'ESPACE DE FICHIERS (Firebase Storage)
//
//  À quoi ça sert : les fichiers envoyés dans les conversations qui
//  dépassent 800 Ko partent ici, en qualité d'origine, jusqu'à 2 Go.
//
//  Où les coller : console.firebase.google.com → ton projet →
//  Storage → onglet « Rules » → tout remplacer → Publier.
//  (Il faut d'abord avoir activé Storage : bouton « Commencer ».)
// ══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    // chaque compte écrit dans SON dossier, 2 Go maximum par fichier
    match /partages/{uid}/{fichier} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size <= 2 * 1024 * 1024 * 1024;
      // lire : tout compte connecté (le lien est partagé dans une conversation)
      allow read:  if request.auth != null;
      // seul l'expéditeur peut effacer son fichier
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // tout le reste est fermé
    match /{tout=**} { allow read, write: if false; }
  }
}
